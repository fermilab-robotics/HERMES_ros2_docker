<?xml version="1.0"?>

<!-- Contains all our plugins -->
<robot name="hermes" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo>
        <!-- Control is in a different file -->
        <!-- Publish joint states to gz -->
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
        </plugin>
        <!-- Needed for any rendering sensors (lidar, camera) attached to this model -->
        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>
        <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <!-- Path to controller yaml -->
            <parameters>$(find hermes_description)/config/my_controllers.yaml</parameters>
            <!-- Use_sim_time true -->
            <parameters>$(find hermes_description)/config/gaz_ros2_ctl_use_sim.yaml</parameters>
        </plugin>
    </gazebo>

</robot>
