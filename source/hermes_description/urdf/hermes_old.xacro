<?xml version="1.0"?>
<robot name="hermes" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find hermes_description)/urdf/materials.xacro" />
<xacro:include filename="$(find hermes_description)/urdf/hermes.trans" />
<xacro:include filename="$(find hermes_description)/urdf/hermes.gazebo" />

<link name="base_link">
  <inertial>
    <origin xyz="0.10477500075901933 -0.1111250007629394 0.05391906662822746" rpy="0 0 0"/>
    <mass value="81.72374908316645"/>
    <inertia ixx="0.615655" iyy="0.885686" izz="1.349622" ixy="0.0" iyz="0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find hermes_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="orange"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find hermes_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

