<joint name="base_to_wheel_rear_right" type="continuous">
  <origin xyz="-0.060325 0.3048 0.041275" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="wheel_rear_right"/>
  <axis xyz="0 1 0" />
</joint>

<joint name="base_to_wheel_middle_right" type="continuous">
  <origin xyz="-0.060325 0.1778 0.041275" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="wheel_middle_right"/>
  <axis xyz="0 1 0" />
</joint>

<joint name="base_to_wheel_front_right" type="fixed">
  <origin xyz="-0.060325 0.0508 0.041275" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="wheel_front_right"/>
</joint>

<joint name="base_to_wheel_rear_left" type="fixed">
  <origin xyz="0.339725 0.3048 0.041275" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="wheel_rear_left"/>
</joint>

<joint name="base_to_wheel_middle_left" type="fixed">
  <origin xyz="0.339725 0.1778 0.041275" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="wheel_middle_left"/>
</joint>

<joint name="base_to_wheel_front_left" type="fixed">
  <origin xyz="0.339725 0.0508 0.041275" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="wheel_front_left"/>
</joint>

</robot>