<?xml version="1.0"?>

<robot name="hermes" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <joint name="camera_joint" type="fixed">
        <parent link="chassis" />
        <child link="camera_link" />
        <origin xyz="${chassis_length * 0.8} 0 ${chassis_height + camera_height}" rpy="0 0 0"/>
    </joint>

    <link name="camera_link">
        
        <visual>
            <geometry>
                <box size="0.010 0.03 0.03" />
            </geometry>
            <material name="red" />
        </visual>
        <!-- Add collision if camera sticks out -->
<!-- 
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.04" />
            </geometry>
        </collision>

        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
            <origin xyz="0 0 0" rpy="0 0 0" />
        </xacro:inertial_cylinder> -->

    </link>

    <!-- UPDATE: Camera does NOT use a diff coord sys-->
    <!-- Camera uses a different coordinate system than ROS2 standard. Convert between -->
    <!-- <joint name="camera__joint" type="fixed">
        <parent link="chassis" />
        <child link="camera_link" />
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>  -->


    <gazebo reference="camera_link">
        <material>Gazebo/Red</material>
        


        <!-- A scanning lidar ray-->
        
        <sensor name="camera" type="camera">
            <pose relative_to="camera_link"> 0 0 0 0 0 0 </pose>

            <topic>camera</topic>
            <visualize>true</visualize>
            <update_rate>10</update_rate>

            <camera>
                <!-- Adjust based on camera -->
                <horizontal_fov>1.1</horizontal_fov>
                <image>
                    <format>R8G8B8</format>
                    <width>640</width>
                    <height>480</height>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>8.0</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>
</robot>
