<?xml version="1.0"?>
<robot name="hermes" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <material name="orange">
        <color rgba="1 0.3 0.4 1" />
    </material>
    <xacro:property name="radius" value="1.0" />
    <xacro:property name="leglen" value="0.3" />
    <link name="base_link">
        <visual>
            <geometry>
                <cylinder length="2.0" radius="${radius}"/>
            </geometry>
        </visual>
    </link>
    <xacro:macro name="leg" params="prefix orientation">
        <link name="${prefix}_leg">
            <visual>
                <geometry>
                    <box size="${leglen} 0.1 0.2" />
                </geometry>
                <origin xyz="0 0 -${leglen/2}" rpy="0 ${pi/2} 0"/>
                <material name="orange"/>
            </visual>

        </link>
        <joint name="base_to_${prefix}_leg" type="continuous">
            <parent link="base_link" />
            <child link="${prefix}_leg" />
            <origin xyz="0 ${orientation*(radius+0.1)} 0.25" />
            <axis xyz="0 1 0"/>
        </joint>
    </xacro:macro >
    <xacro:leg prefix="right" orientation="1"/>
    <xacro:leg prefix="left" orientation="-1"/>
</robot>