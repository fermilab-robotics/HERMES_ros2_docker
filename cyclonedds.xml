<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS>
    <Domain>
        <General>
            
            <!-- Matches  interface name .. .where does this number come from? -->
            <!-- presence_required so it doesn't fail andcrash if it doesn't find one-->
            <Interfaces>
                <!-- For Pi -->
                <NetworkInterface name="wlan0" priority="default" multicast="default" presence_required="false"/>
                <!-- Pi Wifi Adapter-->
                <NetworkInterface name="wlan1" priority="default" multicast="default" presence_required="false"/>
                <!-- For thinkpad-->
                <NetworkInterface name="wlp4s0" priority="default" multicast="default" presence_required="false"/>
            </Interfaces>
            <!-- Restrict cyclonedds to specific interfaces -->
            <DontRoute>true</DontRoute>
            <!--
            <AllowMulticast>true</AllowMulticast>
            <EnableMulticastLoopback>true</EnableMulticastLoopback>
            -->
            <AllowMulticast>true</AllowMulticast>
        </General>
        <Discovery>
            <Peers>
                <Peer address="10.42.0.1" />
                <Peer address="10.42.0.17" />
                <Peer address="10.42.0.16" />
                <!-- Common auto route interfaces -->
                <Peer address="10.42.0.43" />
            </Peers>
        </Discovery>
    </Domain>
</CycloneDDS>